[
  {
    "start": 0,
    "end": 1.4,
    "text": "地球和苹果像大人和小孩，被同一根绳连在一起。"
  },
  {
    "start": 1.4,
    "end": 2.2,
    "text": "绳子的拉力大小相同，同时作用在双方身上。"
  },
  {
    "start": 2.2,
    "end": 4.7,
    "text": "苹果更轻，所以向左移动得更多；地球只移动一点点。"
  },
  {
    "start": 4.7,
    "end": 5.3,
    "text": "同样大的拉力下，质量越小，运动越明显。"
  }
]
